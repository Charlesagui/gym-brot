# Cache: los assets de SvelteKit y los videos tienen el hash o el id en el nombre,
# así que son inmutables. Sin esto Netlify los sirve con must-revalidate y cada
# carga paga una condicional por archivo.
/_app/immutable/*
  Cache-Control: public, max-age=31536000, immutable

/videos/*
  Cache-Control: public, max-age=31536000, immutable

/icons/*
  Cache-Control: public, max-age=604800

# El service worker y el shell tienen que revalidarse siempre: si se cachean,
# una versión nueva puede tardar días en llegar al teléfono.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/manifest.webmanifest
  Cache-Control: public, max-age=0, must-revalidate

# La app no tiene backend ni auth: esto es endurecimiento barato. El único origen
# externo es el iframe de YouTube de "Ver técnica".
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob:; font-src 'self'; connect-src 'self'; worker-src 'self'; manifest-src 'self'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'none'; object-src 'none'
